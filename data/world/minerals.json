{"asof":"2024","source":"US Geological Survey Mineral Commodity Summaries (rounded); refining from IEA and company reports","order":["li","co","ni","cu"],"m":{"li":{"n":"Lithium","uses":"Rechargeable batteries (electric cars, phones, grid storage), plus glass and ceramics.","note":"Bolivia and Argentina hold some of the biggest resources, but 'reserves' only count what is proven and workable today, so Bolivia (little output so far) barely shows.","ramp":[[120,20,70],[230,50,120],[255,140,190],[255,230,240]],"tint":[240,80,150],"np":7,"nr":8,"top":"AUS","top_sh":37,"rtop":"CHL","rtop_sh":34,"fields":[{"n":"Greenbushes (Western Australia)","lat":-33.86,"lon":116.06,"t":35,"note":"The world's biggest hard-rock lithium mine."},{"n":"Pilbara (Western Australia)","lat":-21.0,"lon":118.9,"t":35,"note":"Several large spodumene mines."},{"n":"Goldfields (Western Australia)","lat":-31.2,"lon":119.4,"t":18,"note":"Mt Marion, Mt Holland and others."},{"n":"Salar de Atacama (Chile)","lat":-23.5,"lon":-68.3,"t":49,"note":"Lithium from brine, the lowest-cost source in the world."},{"n":"Puna salt flats (Argentina)","lat":-24.6,"lon":-66.9,"t":18,"note":"Brine operations on the Argentine side of the 'lithium triangle'."},{"n":"Yichun (Jiangxi, China)","lat":27.8,"lon":114.4,"t":15,"note":"Lithium from mica rock."},{"n":"Qinghai salt lakes (China)","lat":36.8,"lon":95.3,"t":14,"note":"Brine lakes high on the plateau."},{"n":"Jiajika (Sichuan, China)","lat":30.3,"lon":101.5,"t":12,"note":"Hard-rock mines."},{"n":"Bikita and Sandawana (Zimbabwe)","lat":-20.1,"lon":31.7,"t":28,"note":"Fast-growing Chinese-owned hard-rock mines."},{"n":"Minas Gerais (Brazil)","lat":-16.8,"lon":-42.0,"t":10,"note":"The 'lithium valley'."}],"sites":[{"n":"Ganzhou and Yichun, China","lat":27.0,"lon":115.0,"k":"process","note":"China makes roughly two-thirds of the world's battery-grade lithium chemicals, a lot of it from ore mined elsewhere."},{"n":"Kwinana, Australia","lat":-32.2,"lon":115.77,"k":"process","note":"One of the few big lithium hydroxide plants outside China."},{"n":"Salar de Uyuni, Bolivia","lat":-20.3,"lon":-67.6,"k":"project","note":"One of the largest lithium resources on earth, with almost no output so far."},{"n":"Thacker Pass, USA","lat":41.7,"lon":-118.0,"k":"project","note":"The biggest US lithium project, under construction."}]},"co":{"n":"Cobalt","uses":"Battery cathodes, jet engines, magnets and hard steels.","note":"Cobalt is mostly a by-product of copper and nickel mining, so its supply follows those markets. A large part of Congo's output comes from small-scale and artisanal miners.","ramp":[[20,30,120],[50,90,230],[110,170,255],[225,238,255]],"tint":[70,120,255],"np":10,"nr":7,"top":"COD","top_sh":79,"rtop":"COD","rtop_sh":63,"fields":[{"n":"Katanga Copperbelt (DR Congo)","lat":-10.8,"lon":26.0,"t":190,"note":"Kolwezi, Likasi and Lubumbashi: copper-cobalt mines that supply most of the world."},{"n":"Sulawesi and Halmahera (Indonesia)","lat":-1.5,"lon":124.5,"t":28,"note":"By-product of nickel processing."},{"n":"Norilsk (Russia)","lat":69.35,"lon":88.2,"t":8.7,"note":"From the big nickel-copper complex."},{"n":"Murrin Murrin (Western Australia)","lat":-28.8,"lon":121.9,"t":4.6,"note":"Nickel-cobalt laterite."},{"n":"Surigao (Philippines)","lat":9.7,"lon":125.6,"t":3.8,"note":"Nickel laterite by-product."},{"n":"Moa (Cuba)","lat":20.67,"lon":-74.9,"t":3.3,"note":"Nickel-cobalt plant."},{"n":"Ambatovy (Madagascar)","lat":-18.8,"lon":48.3,"t":3.0,"note":"Nickel-cobalt mine."},{"n":"Sudbury and Voisey's Bay (Canada)","lat":46.5,"lon":-81.0,"t":3.0,"note":"By-product of nickel."},{"n":"Ramu (Papua New Guinea)","lat":-5.8,"lon":145.7,"t":3.0,"note":"Nickel-cobalt mine."},{"n":"Bou Azzer (Morocco)","lat":30.4,"lon":-6.9,"t":2.3,"note":"A rare primary cobalt mine."}],"sites":[{"n":"Huaiyin and Ganzhou, China","lat":33.6,"lon":119.0,"k":"process","note":"China refines roughly three-quarters of the world's cobalt, much of it from Congo concentrate."},{"n":"Kokkola, Finland","lat":63.84,"lon":23.13,"k":"process","note":"Europe's main cobalt refinery."},{"n":"Kolwezi, DR Congo","lat":-10.7,"lon":25.5,"k":"project","note":"Heart of the mining area. Congo introduced export limits in 2025, so supply can change fast."}]},"ni":{"n":"Nickel","uses":"Stainless steel and battery cathodes.","note":"New Caledonia (France) is also a big producer (about 190 thousand tonnes) and holds about 7 million tonnes of reserves, but it isn't a separate country on this map.","ramp":[[90,90,20],[220,210,40],[255,245,130],[255,255,230]],"tint":[235,220,50],"np":7,"nr":7,"top":"IDN","top_sh":67,"rtop":"IDN","rtop_sh":48,"fields":[{"n":"Morowali and Sulawesi (Indonesia)","lat":-2.5,"lon":122.0,"t":1400,"note":"Huge Chinese-built smelters turn laterite ore into nickel; Indonesia's output has exploded since 2020."},{"n":"Halmahera and Obi (Indonesia)","lat":0.4,"lon":127.8,"t":800,"note":"Another cluster of nickel processing parks."},{"n":"Surigao (Philippines)","lat":9.6,"lon":125.6,"t":330,"note":"Mostly raw ore shipped to China."},{"n":"Norilsk (Russia)","lat":69.35,"lon":88.2,"t":200,"note":"The biggest Russian nickel and palladium complex."},{"n":"New Caledonia (France)","lat":-21.5,"lon":165.8,"t":190,"note":"Big nickel mines and plants, struggling with costs and unrest."},{"n":"Sudbury (Canada)","lat":46.5,"lon":-81.0,"t":190,"note":"A century-old mining district."},{"n":"Kambalda (Western Australia)","lat":-31.2,"lon":121.7,"t":160,"note":"Hit by low prices and mine closures since 2024."},{"n":"Jinchuan (Gansu, China)","lat":38.5,"lon":102.2,"t":110,"note":"China's main nickel mine."},{"n":"Goi\u00e1s and Par\u00e1 (Brazil)","lat":-15.0,"lon":-49.5,"t":80,"note":"Laterite mines."}],"sites":[{"n":"Morowali Industrial Park, Indonesia","lat":-2.8,"lon":122.2,"k":"process","note":"The world's biggest nickel processing site, built with Chinese money."}]},"cu":{"n":"Copper","uses":"Power grids, wiring, motors, EVs and buildings. It is often watched as a gauge of the economy, 'Dr Copper'.","note":"Grasberg (Indonesia) had a mud-rush accident in 2025 that cut output, and big mines lose ore grade over time.","ramp":[[10,90,80],[30,190,150],[130,240,190],[235,255,240]],"tint":[40,210,170],"np":11,"nr":9,"top":"CHL","top_sh":28,"rtop":"CHL","rtop_sh":26,"fields":[{"n":"Northern Chile (Escondida, Chuquicamata)","lat":-23.5,"lon":-68.9,"t":4200,"note":"The world's richest copper belt, in the Atacama Desert."},{"n":"Central Chile (El Teniente)","lat":-34.1,"lon":-70.4,"t":1100,"note":"The biggest underground copper mine."},{"n":"Katanga Copperbelt (DR Congo)","lat":-10.8,"lon":26.0,"t":3300,"note":"Growing very fast, often together with cobalt."},{"n":"Southern Peru","lat":-15.5,"lon":-72.0,"t":1500,"note":"Cuajone, Cerro Verde and Las Bambas."},{"n":"Antamina and central Peru","lat":-9.5,"lon":-77.0,"t":1100,"note":"Big open-pit mines in the Andes."},{"n":"Tibet and Yunnan (China)","lat":29.3,"lon":91.5,"t":900,"note":"High-altitude mines."},{"n":"Dexing (Jiangxi, China)","lat":28.9,"lon":117.7,"t":900,"note":"Asia's biggest open-pit copper mine."},{"n":"Arizona and Utah (USA)","lat":33.4,"lon":-111.0,"t":1100,"note":"Most US copper."},{"n":"Urals and Norilsk (Russia)","lat":62.0,"lon":60.0,"t":930,"note":"Spread across several districts."},{"n":"Grasberg (Indonesia)","lat":-4.05,"lon":137.1,"t":920,"note":"One of the world's biggest copper and gold mines."},{"n":"Olympic Dam (South Australia)","lat":-30.4,"lon":136.9,"t":800,"note":"Copper, uranium and gold."},{"n":"Zambian Copperbelt","lat":-12.8,"lon":28.2,"t":750,"note":"Zambia's main industry."},{"n":"Sonora (Mexico)","lat":30.2,"lon":-110.3,"t":750,"note":"Cananea and other mines."},{"n":"British Columbia (Canada)","lat":50.5,"lon":-120.5,"t":720,"note":"Open-pit mines."}],"sites":[{"n":"Guixi and Jiangxi smelters, China","lat":28.3,"lon":117.2,"k":"process","note":"China smelts and refines about 40% of the world's copper, more than it mines."}]}},